# Copier en .streamlit/secrets.toml et renseigner.
# Ce fichier d'exemple est versionné ; secrets.toml ne l'est jamais.

[mysql]
host = "mysql-xxxx.aivencloud.com"
port = 12345
user = "avnadmin"
password = "CHANGEME"
database = "defaultdb"
# Certificat CA fourni par Aiven (onglet Overview du service).
# SSL est obligatoire : sans ca_cert, la connexion n'est pas vérifiée.
ca_cert = """
-----BEGIN CERTIFICATE-----
CHANGEME
-----END CERTIFICATE-----
"""

# Admin initial, créé par bootstrap() uniquement si la table users est vide.
# Le mot de passe est haché en base ; must_change_pwd est posé à 1.
[bootstrap_admin]
nom = "Administrateur"
email = "admin@example.org"
password = "CHANGEME-10-caracteres-min"
